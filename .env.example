NODE_ENV=development
PORT=4317
PUBLIC_ORIGIN=http://localhost:4317
APP_SECRET=
# A separate Supabase PostgreSQL database. Blank uses local SQLite in development.
DATABASE_URL=
DATABASE_SSL_CA=certs/supabase-root-2021.crt
AI_PROVIDER=cloudflare
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_SPEECH_MODEL=whisper-large-v3
# An explicitly selected vision model, separate from the text-only Llama planner.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Cloudflare hosts the Meta reasoning and vision models; speech uses Gemini/Intron.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MEDIA_PROVIDER=gemini
IMAGE_PROVIDER=cloudflare
GEMINI_AUDIO_MODEL=gemini-3.5-transcribe
INTRON_STT_ENABLED=true
INTRON_API_KEY=
GEMINI_MEDIA_MODEL=gemini-3.5-flash-lite
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_ASR_MODEL=muse-voice-transcribe-1.0
SAM_LEDGER_CROP=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_PUBLIC_NUMBER=
