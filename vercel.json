{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["lhr1"],
  "git": { "deploymentEnabled": false },
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{src/**,certs/**,web/public/**,node_modules/ffmpeg-static/ffmpeg*}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/webhooks/whatsapp", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/internal/recover", "destination": "/api/index" },
    { "source": "/open", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/internal/recover", "schedule": "0 8 * * *" }]
}
